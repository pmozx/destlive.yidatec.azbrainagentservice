# ==================== 测试环境配置 ====================
# 服务配置
HOST=0.0.0.0
PORT=8001
RELOAD=false

# 数据库配置：postgres-5432、mysql-3306、sqlite
# 容器内按容器名直连（devops/common-server 的 POSTGRES_DB 须与本处 DATABASE_NAME 一致）
DATABASE_TYPE=postgres
DATABASE_HOST=service-brain-postgres
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=123123
DATABASE_NAME=service_brain_agent_test
DATABASE_ECHO=false

# 向量存储（pgvector）：维度须与 embedding 模型输出一致（bge-m3=1024）
VECTOR_ENABLE=true
VECTOR_DIM=1024
VECTOR_AUTO_CREATE=true

# 日志配置
LOGGER_LEVEL=INFO
