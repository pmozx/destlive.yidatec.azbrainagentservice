# ==============================================================================
# devops/compose/app.yml 的取值示例（仅本地 / 手工部署时使用）
#
#   CI 流水线中无需本文件：deploy-compose.sh 的变量由 deploy-defaults.sh 提供默认值。
#   手工使用时：复制为同目录 .env（已 gitignore），再执行
#     docker compose -p service-brain-agent -f devops/compose/app.yml up -d
#
#   注意：应用配置与数据库口令在 env/.env.<ENVIRONMENT>（挂载进容器），不是本文件；
#        本文件只提供 compose 自身的插值变量。
# ==============================================================================

# 镜像全名:标签（必需）
APP_IMAGE=crpi-7nbh1cvsjd338a37.cn-qingdao.personal.cr.aliyuncs.com/yidatec-mxx/service-brain-agent:20260101000000

# 容器名 / compose 项目名
APP_NAME=service-brain-agent

# 目标环境（决定挂载哪个 env/.env.<ENVIRONMENT>，必需）
ENVIRONMENT=dev

# 宿主机暴露端口（容器内固定 8002）
APP_PORT=8002

# 与中间件共用的外部 docker 网络名（必需，须已存在）
APP_NETWORK=service-brain-agent
