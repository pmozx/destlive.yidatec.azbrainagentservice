# ==============================================================================
# devops/common-server/docker-compose.yml 的取值清单
#
#   编排已按本文件内联全部取值，默认不再读取本文件，也无需复制为 .env：
#     docker compose -f devops/common-server/docker-compose.yml up -d
#
#   本文件保留两个用途：①记录每一项的含义与默认值；②需要“口令不入库”时，把编排
#   里的 POSTGRES_PASSWORD 改回 ${POSTGRES_PASSWORD:?}，再 cp .env.example .env 填实值。
#   口令必须与 env/.env.<环境> 中的 DATABASE_PASSWORD 一致（同一口令的两种存储形态）。
# ==============================================================================

# PostgreSQL 超级用户（必需，应用连接也默认用它；口令严禁写入被跟踪文件）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=yd@123..

# 首次初始化时创建的数据库名（须与 env/.env.<环境> 的 DATABASE_NAME 一致）
POSTGRES_DB=service_brain_agent

# 宿主侧端口（仅绑 127.0.0.1）
POSTGRES_PORT=5432

# 与应用共用的外部 docker 网络名（必需，须已存在）
APP_NETWORK=service-brain-agent

# ==================== 模型服务（Ollama 向量化 / llama.cpp 重排序） ====================
# 向量化模型：bge-m3，输出 1024 维，必须与 env/.env.<环境> 的 VECTOR_DIM 一致
OLLAMA_EMBED_MODEL=bge-m3

# 推理镜像（锁版本，勿用 latest；升级等同于一次需要回归验证的变更）
#   ollama/ollama:0.40.11                    当前稳定线 0.40 的最新补丁（2026-10-24）
#   ghcr.io/ggml-org/llama.cpp:server-b11889  llama.cpp 无稳定版，按构建号固定
#   curlimages/curl 仅用于一次性下载 rerank GGUF，不参与推理，保持 latest 即可
OLLAMA_IMAGE=ollama/ollama:0.40.11
LLAMACPP_IMAGE=ghcr.io/ggml-org/llama.cpp:server-b11889
CURL_IMAGE=curlimages/curl:latest

# 宿主机调试端口，仅绑 127.0.0.1（应用走内部网络 service-brain-ollama:11434 / service-brain-rerank:8080）
OLLAMA_PORT=11434
RERANK_PORT=8080

# 向量化模型常驻时长与并发（常驻避免每次检索冷加载）
OLLAMA_KEEP_ALIVE=24h
OLLAMA_NUM_PARALLEL=2

# 重排序模型：Q8_0 约 600MB；国内直连 HF 不通，默认走 hf-mirror
RERANK_MODEL_FILE=bge-reranker-v2-m3-Q8_0.gguf
RERANK_MODEL_URL=https://hf-mirror.com/gpustack/bge-reranker-v2-m3-GGUF/resolve/main/bge-reranker-v2-m3-Q8_0.gguf
# CPU 推理上下文长度与线程数（线程建议取宿主机逻辑核数的一半）
RERANK_CTX_SIZE=8192
RERANK_THREADS=4
