# ==================== 开发环境 ====================
# 应用标题
VITE_APP_TITLE=Service Brain Agent Dashboard
# 应用子标题
VITE_APP_SUBTITLE=AGENT CONSOLE
# 应用描述
VITE_APP_DESCRIPTION=服务大脑智能体控制台
# 应用版本
VITE_APP_VERSION=1.0.0

# 前端部署基础路径（与后端 app.frontend('/ui', ...) 保持一致）
VITE_APP_BASE=/ui/

# 请求基础路径：留空表示同源相对路径，开发环境由下面的代理转发到 FastAPI
VITE_API_BASE_URL=

# FastAPI 后端地址（仅开发环境使用，生产由后端同源托管）
VITE_PROXY_TARGET=http://127.0.0.1:8002

# 需要代理到后端的路径前缀，多个用英文逗号分隔
VITE_PROXY_PREFIXES=/api00_start,/api01_basic,/api02_middleware,/api03_depends,/item,/system,/openapi.json,/docs
