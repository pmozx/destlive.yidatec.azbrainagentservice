# ==================== 开发环境 ====================
# 应用标题
VITE_APP_TITLE=Service Brain Agent Dashboard
# 应用子标题
VITE_APP_SUBTITLE=AGENT CONSOLE
# 应用描述
VITE_APP_DESCRIPTION=服务大脑智能体控制台
# 应用版本
VITE_APP_VERSION=1.0.0

# 前端部署基础路径（与后端 app.frontend('/ui', ...) 保持一致）
VITE_APP_BASE=/ui/

# 接口前缀（axios baseURL；须与后端 app/api/v1/routers.py 的 API_PREFIX、
# vite.config 代理键保持一致，开发环境经代理转发到 FastAPI）
VITE_APP_BASE_API=/api/v1

# 代理目标：本机后端（仅 Vite dev server 使用，生产由后端同源托管）
VITE_API_BASE_URL=http://127.0.0.1:8002
