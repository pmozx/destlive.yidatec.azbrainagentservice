######################################################################
# Build Tools
.venv
# 注意：uv.lock 必须入库——镜像按 uv.lock 精确还原依赖（uv sync --frozen）

.gradle
/build/
!gradle/wrapper/gradle-wrapper.jar

target/
!.mvn/wrapper/maven-wrapper.jar

######################################################################
# IDE

### STS ###
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans

### IntelliJ IDEA ###
.idea
*.iws
*.iml
*.ipr

### JRebel ###
rebel.xml

### NetBeans ###
nbproject/private/
build/*
nbbuild/
dist/
nbdist/
.nb-gradle/

### vscode ###
.vscode

######################################################################
# Others
*.log
logs
data/
*.xml.versionsBackup
*.swp

!*/build/*.java
!*/build/*.html
!*/build/*.xml

######################################################################
# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# 注意：backend/env/ 是环境配置目录（.env.dev 等），不能加入忽略

######################################################################
# Frontend（frontend）
# 依赖与包管理器缓存
node_modules/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/

# 前端构建中间产物（最终产物输出到 backend/static/，由 fastapi app.frontend 托管）
frontend/dist/
frontend/.vite/
frontend/.cache/
frontend/package-lock.json
frontend/pnpm-lock.yaml
frontend/pnpm-workspace.yaml

# 本地环境覆盖文件（backend/env/*.env.* 需入库，仅忽略 .local 覆盖）
.env.local
.env.*.local

# 前端日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 静态资源（后端静态目录下的前端构建产物）
backend/static/assets/
backend/static/index.html
backend/static/favicon.svg

######################################################################
# DevOps（部署与运行数据）
# 当前镜像 tag：构建脚本写入、部署脚本读取，不入库
image_tag.txt
# compose 插值文件（含口令）与容器持久化目录；.env.example 入库
# 注意：应用运行配置是 env/.env.<环境>（需入库模板、非开发环境口令按部署机维护），不在此列
devops/**/*.env
devops/data/
devops/**/volumes/

# 如需不提交前端构建产物（改由 CI 构建），取消下面三行注释
# backend/static/assets/
# backend/static/index.html
# backend/static/favicon.svg
