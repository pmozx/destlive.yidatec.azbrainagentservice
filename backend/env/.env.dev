# ==================== 开发环境配置 ====================
# 服务配置
HOST=0.0.0.0
PORT=8000
RELOAD=true

# 数据库配置：postgres-5432、mysql-3306、sqlite
# 本地起应用连 127.0.0.1；数据库由 devops/common-server 的 compose 发布到回环地址
DATABASE_TYPE=postgres
DATABASE_HOST=192.168.29.120
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=yd@123..
DATABASE_NAME=service_brain_agent
DATABASE_ECHO=true

# 向量存储（pgvector）：维度须与 embedding 模型输出一致（bge-m3=1024）
VECTOR_ENABLE=true
VECTOR_DIM=1024
VECTOR_AUTO_CREATE=true

# 日志配置
LOGGER_LEVEL=DEBUG
