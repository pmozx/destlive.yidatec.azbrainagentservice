# ==================== 生产环境配置 ====================
# 服务配置
HOST=0.0.0.0
PORT=8000
RELOAD=false

# 数据库配置：postgres-5432、mysql-3306、sqlite
# 容器内按容器名直连 service-brain-postgres:5432（宿主发布端口 39990 仅同网段客户端使用）
# POSTGRES_DB 须与本处 DATABASE_NAME 一致
DATABASE_TYPE=postgres
DATABASE_HOST=service-brain-postgres
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=Yidatec@2026!
DATABASE_NAME=service_brain
DATABASE_ECHO=false

# 向量存储（pgvector）：维度须与 embedding 模型输出一致（bge-m3=1024）
VECTOR_ENABLE=true
VECTOR_DIM=1024
VECTOR_AUTO_CREATE=true

# 对象存储（S3 兼容，devops/common-server 的 minio 服务）
# 容器内按容器名直连：宿主发布端口 39900 仅同网段客户端使用
# S3_SECRET_KEY 为密钥，只写在 env 里；生产环境必须换成最小权限子账号而非 root
S3_ENABLE=true
S3_ENDPOINT=http://service-brain-minio:9000
S3_ACCESS_KEY=service-brain
S3_SECRET_KEY=Yidatec@2026!
S3_BUCKET=service-brain
S3_REGION=us-east-1
S3_USE_SSL=false
S3_ADDRESSING_STYLE=path
S3_AUTO_CREATE=true
S3_TIMEOUT=30
S3_PRESIGN_EXPIRE=3600
S3_KEY_PREFIX=

# ==================== 正式接入层（/v1 契约，app/contract） ====================
# 开启后 POC 的 /v1 路由自动下线（同一路径不能挂两份实现）
CONTRACT_V1_ENABLE=true
# 调用方标识与共享密钥由 GSI 下发（计划 W10 到位），两侧必须一致
CONTRACT_V1_CLIENT_ID=gsi-service
# 【待填】GSI 下发的 HMAC 共享密钥：只写部署机上的本文件，不入库、不进代码、不提交实值
# 留空 = 未配置，/v1 一律 503 AUTHORIZATION_UNAVAILABLE（不会放过签名）
CONTRACT_V1_SHARED_SECRET=
# 以下按契约口径取默认值，GSI 未另行约定时保持不动
CONTRACT_CLOCK_SKEW_MS=300000
CONTRACT_NONCE_TTL_SECONDS=600
CONTRACT_AUTHORIZATION_MAX_TTL_MS=120000
CONTRACT_IDEMPOTENCY_TTL_DAYS=90
CONTRACT_TENANT_ID=gsi-default

# 日志配置
LOGGER_LEVEL=WARNING
