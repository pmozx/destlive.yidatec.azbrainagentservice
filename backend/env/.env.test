# ==================== 测试环境配置 ====================
# 服务配置
HOST=0.0.0.0
PORT=8002
RELOAD=false
# 业务时区：库里 timestamptz 按 UTC 存，接口输出前换算到该时区（页面按本地时间展示）
TIMEZONE=Asia/Shanghai

# 数据库配置（同 gsi 共享）
DATABASE_TYPE=postgres
DATABASE_HOST=119.3.181.134
DATABASE_PORT=39990
DATABASE_USER=postgres
DATABASE_PASSWORD=Yidatec@2026!
DATABASE_NAME=service_brain
DATABASE_ECHO=false

# 向量存储（pgvector）：维度须与 embedding 模型输出一致（bge-m3=1024）
VECTOR_ENABLE=true
VECTOR_DIM=1024
VECTOR_AUTO_CREATE=true

# 模型服务（app/modules/integration）：地址留空 = 未接入，调用时报 503 并提示该填哪个变量
# 下面几项默认注释：容器内应用按服务名直连时再打开（compose 未给这两个服务发布宿主端口，
# 本机调试需先自行发布端口），口径见 devops/README.md 6.5
LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_API_KEY=sk-dytafwetvdsenhngewpildwzstscrmugqmkaspwsxsyqdwqu
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
EMBEDDING_PROTOCOL=ollama
EMBEDDING_BASE_URL=http://service-brain-ollama:11434
EMBEDDING_MODEL=bge-m3
# 单批条数：本机实测 bge-m3 约 1.2s/块（800 字符，CPU 推理），16 条一批要 20s+，
# 容易撞上网关/代理的 30s 上限；降到 8 让单个请求约 10s，超时重试的代价也更小
EMBEDDING_BATCH_SIZE=8
# 分批并发：本机是 CPU 推理，2 路已能吃满；调到 3+ 会让单批耗时反升
EMBEDDING_CONCURRENCY=2
# 单批失败重试次数（指数退避），网关偶发 502 时不必整单重来
EMBEDDING_MAX_RETRIES=2
RERANK_BASE_URL=http://service-brain-rerank:8001
RERANK_MODEL=bge-reranker-v2-m3
# llama.cpp --rerank 返回的是交叉编码器 logit（实测 -4~+8，可正可负），应用侧 sigmoid 压到 0–1
# 再做相关度闸门；换成 Jina/Cohere 同构服务（直接返回 0–1 概率）时置 false
RERANK_SCORE_IS_LOGIT=true

# 文档解析线程池与分片（按字符数计，不折算 token）
PARSE_THREAD_POOL_SIZE=4
PARSE_CHUNK_SIZE=800
PARSE_CHUNK_OVERLAP=120

# MinerU 文档解析（当前暂定的“内容提取”主路径：PDF / Office / 图片）
# MINERU_API_TOKEN 为密钥，只写在 env 里，不入库、不进代码、不提交到仓库
MINERU_ENABLE=true
MINERU_API_TOKEN=sk-CfkhbpNwUuhSvUJ7QHOYGkscFRzp96tM7TimXnBA3nwb7kyz
# 私有化部署时覆盖；留空用 SDK 官方默认地址
MINERU_BASE_URL=
MINERU_FLASH_BASE_URL=
MINERU_MODEL=vlm
MINERU_TIMEOUT=300
MINERU_OCR=true
MINERU_LANGUAGE=ch

# 对象存储（华为云 OBS，S3 兼容协议）
# provider 标识存储服务商类型：huawei-obs
# endpoint 使用华为云对象存储区域终端节点
# access_key_id / secret_access_key 为华为云访问密钥，仅写在 env 里，不入库、不进代码
# bucket 由应用启动时按 S3_AUTO_CREATE 幂等创建
S3_ENABLE=true
S3_ENDPOINT=https://obs.cn-north-4.myhuaweicloud.com
S3_ACCESS_KEY=EORO303I4QWO1A481FZ9
S3_SECRET_KEY=CPR278becc5ivMUQ2Suw8kV1dx4V2xXj4lPoZ95l
S3_BUCKET=service-brain-dev
S3_REGION=
S3_USE_SSL=true
S3_ADDRESSING_STYLE=virtual
S3_AUTO_CREATE=true
S3_TIMEOUT=30
S3_PRESIGN_EXPIRE=3600
S3_KEY_PREFIX=gsi/dev/agent/

# ==================== 正式接入层（/v1 契约，app/modules_api/contract） ====================
# 开启后 POC 的 /v1 路由自动下线（同一路径不能挂两份实现）
CONTRACT_V1_ENABLE=true
# 调用方标识与共享密钥由 GSI 下发（计划 W10 到位），两侧必须一致
CONTRACT_V1_CLIENT_ID=gsi-service
# 【待填】GSI 下发的 HMAC 共享密钥：只写部署机上的本文件，不入库、不进代码、不提交实值
# 留空 = 未配置，/v1 一律 503 AUTHORIZATION_UNAVAILABLE（不会放过签名）
CONTRACT_V1_SHARED_SECRET=bb31fc600584446c627715947dcae10fb2cae572cbc8f4152d76de9d09d69bd1
# 以下按契约口径取默认值，GSI 未另行约定时保持不动
CONTRACT_CLOCK_SKEW_MS=300000
CONTRACT_NONCE_TTL_SECONDS=600
CONTRACT_AUTHORIZATION_MAX_TTL_MS=120000
CONTRACT_IDEMPOTENCY_TTL_DAYS=90
CONTRACT_TENANT_ID=gsi-default
# 测试辅助路由（签名头生成等）：开发环境开启，生产环境必须关闭
CONTRACT_TEST_ENABLE=true

# 日志配置
LOGGER_LEVEL=INFO
